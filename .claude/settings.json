{
  "permissions": {
    "allow": [
      "Bash(git push origin refs/tags/*)",
      "Bash(bash scripts/check-doc-sync.sh)",
      "Bash(bash scripts/check-feature-completeness.sh:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.sh\"" }
        ]
      }
    ]
  }
}
